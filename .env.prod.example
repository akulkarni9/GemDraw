# Copy to .env and fill in before deploying docker-compose.prod.yml.

# --- Postgres (created by the compose stack) ---
POSTGRES_USER=gemdraw
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=gemdraw

# --- Ollama (Gemma 4 26B running natively on the host) ---
# Default reaches the host's native Ollama from inside the container.
# Override only to use a different Ollama host:
#   http://192.168.1.50:11434      (a separate machine on your LAN)
# Rancher Desktop / Lima / Colima: use the VM host gateway 192.168.5.2.
# Docker Desktop: use http://host.docker.internal:11434 instead.
OLLAMA_BASE_URL=http://192.168.5.2:11434
OLLAMA_MODEL=gemma4:26b
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=16384
OLLAMA_NUM_CTX=131072

# --- CORS (optional) ---
# Only needed if you serve the frontend from a DIFFERENT origin than the API
# (i.e. NOT using the bundled Nginx /api proxy). Comma-separated list.
# CORS_ORIGINS=https://gemdraw.example.com
CORS_ORIGINS=
