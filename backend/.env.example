DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/gemdraw

# --- LLM (provider-agnostic via LiteLLM) ---
# Default provider is local Ollama (below). To use a hosted/other provider,
# set LLM_MODEL to a full LiteLLM id and provide LLM_API_KEY. Examples:
#   LLM_MODEL=openai/gpt-4o                     + LLM_API_KEY=sk-...
#   LLM_MODEL=anthropic/claude-3-5-sonnet-latest + LLM_API_KEY=sk-ant-...
#   LLM_MODEL=gemini/gemini-2.0-flash            + LLM_API_KEY=...
#   LLM_MODEL=ollama_chat/qwen2.5:14b            (another local model)
# The model MUST support tool/function calling.
# LLM_MODEL=
# LLM_API_KEY=
# LLM_API_BASE=            # optional endpoint override (OpenAI-compatible servers)
# LLM_TEMPERATURE=0.2
# LLM_MAX_OUTPUT_TOKENS=16384   # used for non-Ollama providers

# --- Ollama (used when LLM_MODEL is unset or starts with ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
